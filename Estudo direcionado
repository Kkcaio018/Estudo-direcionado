 <!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>ESTUDO DIRIGIDO · HTML, CSS, JavaScript, Matemática, IHC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        :root {
            --bg: #0b1120; --bg-card: #1e293b; --bg-page: #0f172a;
            --text: #e2e8f0; --text-secondary: #94a3b8; --accent: #3b82f6;
            --accent-hover: #2563eb; --purple: #a855f7; --success: #22c55e;
            --danger: #ef4444; --warning: #facc15; --border: #334155;
            --radius: 1rem; --radius-lg: 1.8rem; --transition: 0.3s ease;
            --shadow: 0 12px 25px rgba(0,0,0,0.3);
        }
        body.light {
            --bg: #f8fafc; --bg-card: #ffffff; --bg-page: #f1f5f9;
            --text: #0f172a; --text-secondary: #475569; --border: #cbd5e1;
            --shadow: 0 8px 20px rgba(0,0,0,0.06);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: linear-gradient(145deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 85%, black) 100%);
            font-family: 'Inter', sans-serif; color: var(--text);
            min-height: 100vh; padding: 1.5rem;
            transition: background 0.4s, color 0.4s;
        }
        .skip-link { position: absolute; top: -40px; left: 0; background: var(--accent); color: #fff; padding: 8px; z-index: 100; transition: top 0.2s; }
        .skip-link:focus { top: 0; }
        .app { max-width: 1400px; margin: 0 auto; }

        /* TOP BAR */
        .top-bar {
            display: flex; justify-content: space-between; align-items: center;
            flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;
            background: var(--bg-card); padding: 0.8rem 1.5rem;
            border-radius: var(--radius); border: 1px solid var(--border);
            box-shadow: var(--shadow);
        }
        .site-name {
            font-weight: 800; font-size: 1.3rem;
            background: linear-gradient(135deg, var(--purple), var(--accent));
            -webkit-background-clip: text; background-clip: text; color: transparent;
            white-space: nowrap;
        }
        .search-box {
            display: flex; align-items: center; gap: 0.5rem;
            background: var(--bg); border-radius: 30px; padding: 0.5rem 1.2rem;
            border: 2px solid var(--border); flex: 1; max-width: 450px;
            transition: border-color 0.3s;
        }
        .search-box:focus-within { border-color: var(--accent); }
        .search-box input {
            background: transparent; border: none; outline: none;
            color: var(--text); font-size: 0.95rem; width: 100%;
        }
        .search-box i { color: var(--text-secondary); }
        .user-area { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
        .badge-icon { font-size: 1.5rem; filter: grayscale(1); opacity: 0.3; }
        .badge-icon.earned { filter: grayscale(0); opacity: 1; }
        .points-badge, .streak-badge {
            padding: 0.35rem 0.9rem; border-radius: 20px;
            font-weight: 700; font-size: 0.85rem; white-space: nowrap;
        }
        .points-badge { background: var(--accent); color: white; }
        .streak-badge { background: var(--warning); color: black; }
        .btn-icon {
            background: var(--bg); border: 1px solid var(--border); color: var(--text);
            width: 40px; height: 40px; border-radius: 50%; cursor: pointer;
            font-size: 1.1rem; transition: var(--transition);
            display: flex; align-items: center; justify-content: center;
        }
        .btn-icon:hover { background: var(--accent); color: white; }
        .greeting { color: var(--accent); font-weight: 600; font-size: 0.9rem; }

        /* HERO */
        .hero {
            text-align: center; margin-bottom: 1.5rem; padding: 2rem 1rem 1.5rem;
            background: var(--bg-card); backdrop-filter: blur(8px);
            border-radius: var(--radius-lg); border: 1px solid var(--border);
            box-shadow: var(--shadow);
        }
        .hero h1 {
            font-size: 2.5rem;
            background: linear-gradient(135deg, var(--purple), var(--accent));
            -webkit-background-clip: text; background-clip: text; color: transparent;
            margin-bottom: 0.3rem;
        }
        .hero h1 i { margin-right: 10px; color: #60a5fa; }
        .hero .subtitle { color: var(--text-secondary); font-size: 1rem; margin-top: 5px; }
        .hero .status-bar {
            display: flex; justify-content: center; gap: 2rem;
            margin-top: 1rem; flex-wrap: wrap;
        }
        .status-item {
            display: flex; align-items: center; gap: 0.5rem;
            font-size: 0.9rem; color: var(--text-secondary);
        }
        .status-item i { color: var(--accent); }
        .status-dot {
            width: 10px; height: 10px; border-radius: 50%;
            background: var(--success); animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
        .user-name-input {
            display: flex; gap: 0.5rem; align-items: center;
            justify-content: center; margin-top: 1rem;
        }
        .user-name-input input {
            background: var(--bg); border: 1px solid var(--border);
            color: var(--text); padding: 0.5rem 1rem;
            border-radius: 20px; font-size: 0.9rem;
        }
        .btn-small {
            background: var(--accent); border: none; color: white;
            padding: 0.4rem 1rem; border-radius: 20px;
            cursor: pointer; font-size: 0.85rem;
        }

        /* ROADMAP */
        .roadmap-label {
            text-align: center; margin-bottom: 0.8rem;
            color: var(--text-secondary); font-size: 0.85rem;
            font-weight: 500; text-transform: uppercase; letter-spacing: 1px;
        }
        .roadmap {
            display: flex; flex-wrap: wrap; justify-content: center;
            align-items: center; gap: 0.5rem 1.5rem; margin-bottom: 2.5rem;
        }
        .roadmap-step {
            display: flex; flex-direction: column; align-items: center;
            gap: 0.4rem; cursor: pointer; transition: var(--transition);
            position: relative; padding: 0.5rem;
        }
        .roadmap-step .circle {
            width: 55px; height: 55px; border-radius: 50%;
            background: var(--bg-card); border: 2px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; color: var(--text-secondary);
            transition: var(--transition);
        }
        .roadmap-step.completed .circle {
            background: var(--success); border-color: var(--success); color: white;
        }
        .roadmap-step:hover .circle { border-color: var(--accent); transform: scale(1.1); }
        .roadmap-step .label {
            font-size: 0.75rem; color: var(--text-secondary);
            font-weight: 500; text-align: center; max-width: 80px;
        }
        .roadmap-connector {
            width: 35px; height: 3px; background: var(--border);
            border-radius: 3px; flex-shrink: 0;
        }
        .roadmap-connector.done { background: var(--success); }
        @media (max-width: 800px) {
            .roadmap { flex-direction: column; gap: 0.8rem; }
            .roadmap-connector { width: 3px; height: 25px; }
        }
        /* CARDS */
        .card-section-title {
            text-align: center; color: var(--text-secondary);
            font-size: 0.85rem; text-transform: uppercase;
            letter-spacing: 1px; margin-bottom: 1rem;
        }
        .button-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem; margin-bottom: 2rem;
        }
        .topic-card {
            background: var(--bg-card); border-radius: var(--radius-lg);
            padding: 1.6rem; cursor: pointer; transition: all var(--transition);
            border: 1px solid var(--border); box-shadow: var(--shadow);
            display: flex; flex-direction: column; gap: 0.9rem;
            outline: none; position: relative; min-height: 340px;
        }
        .topic-card:hover {
            transform: translateY(-5px); border-color: var(--accent);
            box-shadow: 0 18px 30px rgba(0,0,0,0.4);
        }
        .topic-card:focus-visible {
            box-shadow: 0 0 0 3px rgba(59,130,246,0.5);
            border-color: var(--accent);
        }
        .topic-card .card-accent {
            position: absolute; top: 0; left: 0; width: 6px; height: 100%;
            border-radius: var(--radius-lg) 0 0 var(--radius-lg);
            transition: width 0.3s;
        }
        .topic-card.html-card .card-accent { background: #e34c26; }
        .topic-card.css-card .card-accent { background: #2965f1; }
        .topic-card.js-card .card-accent { background: #f7df1e; }
        .topic-card.math-card .card-accent { background: var(--purple); }
        .topic-card.ihc-card .card-accent { background: #10b981; }
        .topic-card.quiz-card .card-accent { background: var(--warning); }
        .topic-card:hover .card-accent { width: 10px; }
        .card-header {
            display: flex; align-items: center; gap: 12px;
            padding-bottom: 10px; border-bottom: 1px solid var(--border);
        }
        .card-header i { font-size: 2.5rem; }
        .html-card .card-header i { color: #e34c26; }
        .css-card .card-header i { color: #2965f1; }
        .js-card .card-header i { color: #f7df1e; }
        .math-card .card-header i { color: var(--purple); }
        .ihc-card .card-header i { color: #10b981; }
        .quiz-card .card-header i { color: var(--warning); }
        .card-header h3 { font-size: 1.5rem; font-weight: 700; }
        .completed-badge {
            position: absolute; top: 1rem; right: 1rem;
            background: var(--success); color: #000;
            padding: 0.3rem 0.8rem; border-radius: 30px;
            font-weight: 600; font-size: 0.8rem; display: none; z-index: 2;
        }
        .topic-card.completed .completed-badge { display: block; }
        .info-preview { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; flex: 1; }
        .info-preview strong { color: var(--text); display: block; margin-top: 0.5rem; }
        .info-preview ul { margin: 0.3rem 0 0 1.2rem; list-style-type: disc; }
        .info-preview li { margin-bottom: 0.2rem; font-size: 0.85rem; }
        .info-preview code {
            background: var(--bg); padding: 2px 6px; border-radius: 6px;
            font-family: 'Courier New', monospace; color: var(--warning); font-size: 0.8rem;
        }
        .card-meta {
            display: flex; justify-content: space-between; align-items: center;
            font-size: 0.75rem; color: var(--text-secondary);
        }
        .card-meta i { margin-right: 4px; }
        .btn-action {
            background: var(--accent); border: none; padding: 12px;
            border-radius: 40px; color: white; font-weight: 600;
            text-align: center; font-size: 0.95rem;
            transition: background 0.2s; cursor: pointer;
        }
        .topic-card:hover .btn-action { background: var(--accent-hover); }

        /* PAGES */
        .page-container {
            background: var(--bg-page); border-radius: var(--radius-lg);
            padding: 2rem; margin-top: 1.5rem; border: 1px solid var(--border);
            display: none; animation: fadeIn 0.3s ease;
        }
        .page-container.active-page { display: block; }
        .hidden { display: none !important; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
        .page-header {
            display: flex; justify-content: space-between; align-items: center;
            flex-wrap: wrap; margin-bottom: 1.5rem;
            border-bottom: 2px solid var(--accent); padding-bottom: 0.8rem;
        }
        .back-btn {
            background: var(--border); border: none; padding: 0.6rem 1.4rem;
            border-radius: 40px; color: white; font-weight: 500;
            cursor: pointer; transition: 0.2s; font-size: 0.95rem;
        }
        .back-btn:hover { background: var(--accent); }
        .trail {
            display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem;
            background: var(--bg-card); padding: 0.8rem 1.2rem;
            border-radius: var(--radius); border: 1px solid var(--border);
        }
        .trail a {
            color: var(--text-secondary); text-decoration: none;
            font-weight: 500; font-size: 0.85rem; padding: 0.3rem 0.8rem;
            border-radius: 20px; transition: var(--transition);
            background: var(--bg-page); white-space: nowrap;
        }
        .trail a:hover, .trail a.active { background: var(--accent); color: white; }
        .content-section { line-height: 1.8; font-size: 1rem; }
        .content-section h2 {
            color: #60a5fa; margin: 2.5rem 0 1rem;
            border-left: 4px solid var(--accent); padding-left: 1rem; font-size: 1.6rem;
        }
        .content-section h3 { color: var(--purple); margin: 1.8rem 0 0.8rem; font-size: 1.3rem; }
        .content-section p { margin: 0.8rem 0; color: var(--text-secondary); }
        pre {
            background: #0b1120; padding: 1.2rem; border-radius: var(--radius);
            overflow-x: auto; margin: 1.2rem 0; border-left: 4px solid var(--accent);
            font-family: 'Courier New', monospace; font-size: 0.9rem; color: #e2e8f0;
        }
        body.light pre { background: #e2e8f0; color: #0f172a; }
        code { background: #1e293b; padding: 2px 8px; border-radius: 12px; color: var(--warning); }
        table {
            width: 100%; border-collapse: collapse; margin: 1.5rem 0;
            background: var(--bg-card); border-radius: var(--radius); overflow: hidden;
        }
        th, td { padding: 0.8rem 1rem; border-bottom: 1px solid var(--border); text-align: left; }
        th { background: #2d3a5e; font-weight: 600; }
        body.light th { background: #cbd5e1; color: #0f172a; }
        ul, ol { padding-left: 2rem; margin: 1rem 0; }
        li { margin: 0.5rem 0; color: var(--text-secondary); }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
        @media (max-width: 700px) { .grid-2 { grid-template-columns: 1fr; } }
        .analogy-box {
            background: #1a2a1a; border-left: 4px solid var(--success);
            padding: 1rem 1.2rem; border-radius: var(--radius);
            margin: 1rem 0; color: #86efac;
        }
        body.light .analogy-box { background: #dcfce7; color: #166534; }
        .analogy-box strong { color: #4ade80; }
        .info-box {
            background: #1a1a2e; border-left: 4px solid var(--accent);
            padding: 1rem 1.2rem; border-radius: var(--radius);
            margin: 1rem 0; color: #93c5fd;
        }
        .challenge-box {
            background: #2d2a1a; border-left: 4px solid var(--warning);
            padding: 1rem 1.2rem; border-radius: var(--radius);
            margin: 1rem 0; color: #fde68a;
        }
        body.light .challenge-box { background: #fefce8; color: #854d0e; }
        .live-editor {
            display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.5rem 0;
        }
        @media (max-width: 700px) { .live-editor { grid-template-columns: 1fr; } }
        .live-editor textarea {
            background: #0b1120; color: #e2e8f0; border: 1px solid var(--border);
            border-radius: var(--radius); padding: 1rem;
            font-family: 'Courier New', monospace; font-size: 0.85rem;
            resize: vertical; min-height: 200px;
        }
        body.light .live-editor textarea { background: #e2e8f0; color: #0f172a; }
        .live-editor iframe {
            background: white; border: 1px solid var(--border);
            border-radius: var(--radius); width: 100%; min-height: 200px;
        }
        .quiz-item {
            background: var(--bg-card); border-radius: var(--radius);
            padding: 1.5rem; margin: 1.5rem 0;
        }
        .quiz-question { font-weight: 600; margin-bottom: 1rem; color: var(--text); font-size: 1.05rem; }
        .quiz-options label {
            display: block; margin: 0.6rem 0; cursor: pointer;
            padding: 0.5rem; border-radius: 8px; transition: background 0.2s;
        }
        .quiz-options label:hover { background: #2d3a5e; }
        .quiz-feedback {
            margin-top: 1rem; padding: 0.7rem; border-radius: 8px;
            font-weight: 500; display: none;
        }
        .correct-feedback { background: #14532d; color: #86efac; border-left: 4px solid var(--success); display: block; }
        .wrong-feedback { background: #7f1d1d; color: #fca5a5; border-left: 4px solid var(--danger); display: block; }
        .btn-check {
            background: var(--accent); border: none; color: white;
            padding: 0.7rem 1.5rem; border-radius: 30px; margin-top: 0.8rem;
            cursor: pointer; font-weight: 600; font-size: 0.95rem; transition: background 0.2s;
        }
        .btn-check:hover { background: var(--accent-hover); }
        .quiz-score {
            text-align: center; padding: 1.5rem; margin-top: 2rem;
            background: var(--bg-card); border-radius: var(--radius);
            font-size: 1.2rem; font-weight: 600;
        }
        .btn-cert {
            background: var(--success); border: none; color: black;
            padding: 0.8rem 2rem; border-radius: 30px; cursor: pointer;
            font-weight: 600; margin-top: 1rem; font-size: 1rem; transition: background 0.2s;
        }
        .btn-cert:hover { background: #16a34a; }
        .img-emoji { font-size: 3rem; text-align: center; display: block; margin: 1rem 0; }
        .karnaugh-table { display: inline-table; margin: 1rem; }
        .karnaugh-table td { text-align: center; width: 50px; height: 40px; }
        .karnaugh-table th { text-align: center; }
        footer { text-align: center; margin-top: 3rem; color: #5b6e8c; font-size: 0.8rem; }
    </style>
</head>
<body>
<a href="#mainPage" class="skip-link">Pular para conteúdo principal</a>
<div class="app">
    <!-- TOP BAR -->
    <div class="top-bar">
        <span class="site-name">📘 ESTUDO DIRIGIDO</span>
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Buscar tópicos (ex: flexbox, heurísticas, bayes)..." aria-label="Buscar conteúdo">
        </div>
        <div class="user-area">
            <span class="greeting" id="greetingDisplay"></span>
            <span id="badgeContainer" style="display:flex;gap:4px;"></span>
            <span class="points-badge" id="pointsDisplay"><i class="fas fa-star"></i> 0 pts</span>
            <span class="streak-badge" id="streakDisplay"><i class="fas fa-fire"></i> 0 dias</span>
            <button class="btn-icon" id="btnTheme" title="Alternar tema claro/escuro" aria-label="Alternar tema"><i class="fas fa-moon"></i></button>
        </div>
    </div>

    <!-- HERO com cadastro -->
    <div class="hero">
        <h1><i class="fas fa-graduation-cap"></i> ESTUDO DIRIGIDO</h1>
        <p class="subtitle">HTML5 · CSS3 · JavaScript · Matemática Computacional · IHC — Conteúdo completo com exemplos do dia a dia</p>
        <div class="status-bar">
            <span class="status-item"><span class="status-dot"></span> Sistema ativo</span>
            <span class="status-item"><i class="fas fa-clock"></i> <span id="lastAccess">Último acesso: agora</span></span>
            <span class="status-item"><i class="fas fa-check-circle"></i> <span id="modulesDone">0/6 módulos</span></span>
        </div>
        <div class="user-name-input">
            <input type="text" id="userNameInput" placeholder="Digite seu nome para começar" aria-label="Seu nome">
            <button class="btn-small" id="btnSaveName">Cadastrar</button>
        </div>
    </div>

    <!-- ROADMAP -->
    <div class="roadmap-label">🧭 Sua trilha de aprendizado</div>
    <div class="roadmap" id="roadmap">
        <div class="roadmap-step" data-page="html" tabindex="0"><div class="circle"><i class="fab fa-html5"></i></div><span class="label">HTML5</span></div>
        <div class="roadmap-connector" id="conn1"></div>
        <div class="roadmap-step" data-page="css" tabindex="0"><div class="circle"><i class="fab fa-css3-alt"></i></div><span class="label">CSS3</span></div>
        <div class="roadmap-connector" id="conn2"></div>
        <div class="roadmap-step" data-page="javascript" tabindex="0"><div class="circle"><i class="fab fa-js"></i></div><span class="label">JavaScript</span></div>
        <div class="roadmap-connector" id="conn3"></div>
        <div class="roadmap-step" data-page="matematica" tabindex="0"><div class="circle"><i class="fas fa-square-root-alt"></i></div><span class="label">Matemática</span></div>
        <div class="roadmap-connector" id="conn4"></div>
        <div class="roadmap-step" data-page="ihc" tabindex="0"><div class="circle"><i class="fas fa-user-friends"></i></div><span class="label">IHC</span></div>
        <div class="roadmap-connector" id="conn5"></div>
        <div class="roadmap-step" data-page="quiz" tabindex="0"><div class="circle"><i class="fas fa-trophy"></i></div><span class="label">Quiz</span></div>
    </div>

    <!-- PÁGINA PRINCIPAL -->
    <div id="mainPage">
        <div class="card-section-title">📚 Módulos — clique para acessar</div>
        <div class="button-grid" id="cardGrid">
            <!-- HTML Card -->
            <div class="topic-card html-card" data-page="html" tabindex="0" data-keywords="html semântica formulários acessibilidade seo meta viewport">
                <div class="card-accent"></div>
                <span class="completed-badge"><i class="fas fa-check-circle"></i> Concluído</span>
                <div class="card-header"><i class="fab fa-html5"></i><h3>HTML5</h3></div>
                <div class="info-preview">
                    <strong>📄 Estrutura semântica e SEO</strong>
                    <ul><li>Tags semânticas, formulários modernos, meta tags, Open Graph</li></ul>
                    <strong>💡 Cotidiano:</strong> Como o Google entende seu site e leitores de tela ajudam deficientes visuais
                </div>
                <div class="card-meta"><span><i class="fas fa-clock"></i> ~25 min</span><span><i class="fas fa-layer-group"></i> 8 tópicos</span></div>
                <button class="btn-action">🔍 Acessar módulo →</button>
            </div>
            <!-- CSS Card -->
            <div class="topic-card css-card" data-page="css" tabindex="0" data-keywords="css flexbox grid animações container queries especificidade">
                <div class="card-accent"></div>
                <span class="completed-badge"><i class="fas fa-check-circle"></i> Concluído</span>
                <div class="card-header"><i class="fab fa-css3-alt"></i><h3>CSS3</h3></div>
                <div class="info-preview">
