                <tr><td><strong>E</strong>ngagement</td><td>Engajamento</td><td>Tempo de uso diário</td></tr>
                <tr><td><strong>A</strong>doption</td><td>Adoção</td><td>Novos cadastros em 30 dias</td></tr>
                <tr><td><strong>R</strong>etention</td><td>Retenção</td><td>Usuários que voltam após 7 dias</td></tr>
                <tr><td><strong>T</strong>ask Success</td><td>Sucesso na tarefa</td><td>% que conclui a compra</td></tr>
            </table>

