    }
    uS();

    document.getElementById('btnSaveName').addEventListener('click',()=>{const n=document.getElementById('userNameInput').value.trim();if(n){sN(n);uG();alert(`Cadastro realizado, ${n}! Seu progresso será salvo.`);}});

    const mp=document.getElementById('mainPage'),pgs=document.querySelectorAll('.page-container');
    function nT(pid){
        if(pid==='main'){mp.classList.remove('hidden');pgs.forEach(p=>p.classList.remove('active-page'));document.getElementById('roadmap').style.display='flex';document.getElementById('cardGrid').style.display='grid';}
        else{mp.classList.add('hidden');pgs.forEach(p=>p.classList.remove('active-page'));const t=document.getElementById(pid+'Page');if(t){t.classList.add('active-page');t.scrollIntoView({behavior:'smooth',block:'start'});if(pid==='quiz')bQ();const pr=gP();if(!pr[pid]){pr[pid]=true;sP(pr);uG();aP(50);}}document.getElementById('roadmap').style.display='none';document.getElementById('cardGrid').style.display='none';}
    }

    document.querySelectorAll('.roadmap-step').forEach(s=>{s.addEventListener('click',()=>nT(s.dataset.page));s.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();nT(s.dataset.page);}});});
    document.querySelectorAll('.topic-card').forEach(c=>{c.addEventListener('click',()=>nT(c.dataset.page));c.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();nT(c.dataset.page);}});});
    document.querySelectorAll('.back-btn').forEach(b=>b.addEventListener('click',()=>nT('main')));

    document.getElementById('searchInput').addEventListener('input',function(){const term=this.value.toLowerCase().trim();document.querySelectorAll('.topic-card').forEach(c=>{const kw=c.dataset.keywords||'',tx=c.textContent.toLowerCase();c.style.display=(term===''||kw.includes(term)||tx.includes(term))?'flex':'none';});});

    function bQ(){
        const ct=document.getElementById('quizContainer'),sd=document.getElementById('quizScore'),cb=document.getElementById('btnCertificate');
        sd.style.display='none';cb.style.display='none';const qs=selQ();let h='';
        qs.forEach((q,i)=>{h+=`<div class="quiz-item" data-quiz="${q.id}" data-correct="${q.c}"><p class="quiz-question"><span style="color:#a78bfa;">[${q.t}]</span> ${i+1}. ${q.q}</p><div class="quiz-options">${q.o.map((o,ix)=>`<label><input type="radio" name="${q.id}" value="${ix}"> ${o}</label>`).join('')}</div><button class="btn-check" data-quiz="${q.id}">Verificar</button><div class="quiz-feedback"></div></div>`;});
        h+=`<button class="btn-check" id="btnScoreAll" style="display:block;margin:1rem auto;padding:0.8rem 2rem;">📊 Ver pontuação geral</button>`;ct.innerHTML=h;
        ct.querySelectorAll('.btn-check[data-quiz]').forEach(b=>{b.addEventListener('click',function(){const qi=this.dataset.quiz;const it=ct.querySelector(`.quiz-item[data-quiz="${qi}"]`);const cor=parseInt(it.dataset.correct);const fb=it.querySelector('.quiz-feedback');const sl=it.querySelector(`input[name="${qi}"]:checked`);if(!sl){fb.className='quiz-feedback wrong-feedback';fb.textContent='⚠️ Selecione uma opção.';return;}if(parseInt(sl.value)===cor){fb.className='quiz-feedback correct-feedback';fb.textContent='✅ Correto! +15 pts';aP(15);}else{fb.className='quiz-feedback wrong-feedback';fb.textContent='❌ Incorreto.';}});});
        document.getElementById('btnScoreAll').addEventListener('click',()=>{let cor=0;const its=ct.querySelectorAll('.quiz-item');its.forEach(it=>{const qi=it.dataset.quiz;const c=parseInt(it.dataset.correct);const sl=it.querySelector(`input[name="${qi}"]:checked`);if(sl&&parseInt(sl.value)===c)cor++;});const pct=Math.round(cor/its.length*100);sd.innerHTML=`🏆 ${cor}/${its.length} (${pct}%). ${pct>=75?'🎉 Excelente!':pct>=50?'📚 Continue!':'🔄 Revise.'}`;sd.style.display='block';if(pct>=75){cb.style.display='inline-block';aP(50);}sd.scrollIntoView({behavior:'smooth'});});
        document.getElementById('btnCertificate').addEventListener('click',()=>{const nome=gN()||'Estudante';const w=window.open('','cert','width=800,height=600');w.document.write(`<html><head><title>Certificado</title><style>body{font-family:Georgia;text-align:center;padding:3rem;}.cert{border:10px double #3b82f6;padding:3rem;max-width:700px;margin:auto;}h1{font-size:2.5rem;color:#1e293b;}.nome{font-size:2rem;font-weight:bold;color:#3b82f6;margin:1.5rem 0;}</style></head><body><div class="cert"><h1>🎓 Certificado</h1><p>Certificamos que</p><div class="nome">${nome}</div><p>concluiu o <strong>ESTUDO DIRIGIDO</strong> em HTML5, CSS3, JavaScript, Matemática Computacional e IHC.</p><p>Data: ${new Date().toLocaleDateString('pt-BR')}</p></div><script>window.print();<`+`/script></body></html>`);w.document.close();});
    }

    const bt=document.getElementById('btnTheme');
    function aT(t){if(t==='light'){document.body.classList.add('light');bt.innerHTML='<i class="fas fa-sun"></i>';}else{document.body.classList.remove('light');bt.innerHTML='<i class="fas fa-moon"></i>';}}
    const st=localStorage.getItem(TK)||'dark';aT(st);
    bt.addEventListener('click',()=>{const nt=document.body.classList.contains('light')?'dark':'light';localStorage.setItem(TK,nt);aT(nt);});

    const he=document.getElementById('htmlEditor'),hp=document.getElementById('htmlPreview');
    if(he&&hp){function uh(){const d=hp.contentDocument||hp.contentWindow.document;d.open();d.write(he.value);d.close();}document.getElementById('btnRunHtml').addEventListener('click',uh);uh();}
    const che=document.getElementById('cssHtmlEditor'),ce=document.getElementById('cssEditor'),cp=document.getElementById('cssPreview');
    if(che&&ce&&cp){function uc(){const d=cp.contentDocument||cp.contentWindow.document;d.open();d.write(`<style>${ce.value}</style>${che.value}`);d.close();}document.getElementById('btnRunCss').addEventListener('click',uc);uc();}
    const je=document.getElementById('jsEditor'),jo=document.getElementById('jsOutput');
    if(je&&jo){document.getElementById('btnRunJs').addEventListener('click',()=>{const code=je.value;const logs=[];const fc={log:(...a)=>logs.push(a.join(' '))};try{const fn=new Function('console',code);fn(fc);jo.value=logs.join('\n')||'Executado sem saída.';}catch(e){jo.value='Erro: '+e.message;}});}

    document.getElementById('lastAccess').textContent='Último acesso: '+new Date().toLocaleString('pt-BR');
    uG();updateBadges(gPt());
    document.getElementById('pointsDisplay').innerHTML=`<i class="fas fa-star"></i> ${gPt()} pts`;
})();
</script>
<footer>📘 ESTUDO DIRIGIDO — Ferramenta educacional gratuita e independente. Conteúdo completo com exemplos do cotidiano.</footer>
